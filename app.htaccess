<IfModule mod_headers.c>
# The editor processes private audio/text: no advertising or analytics scripts here.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
<FilesMatch "\.(js|css|wasm|woff2?)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<Files "sw.js">
Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
</IfModule>

