{
  "name": "voxtexto",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:hostinger": "tsc -b && vite build --base=/app/ --outDir build/app && node scripts/build-public-site.mjs",
    "preview:hostinger": "node scripts/serve-public-site.mjs",
    "verify:hostinger": "node scripts/verify-public-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && node scripts/package-desktop.cjs",
    "desktop:portable": "npm run build && node scripts/package-desktop.cjs --dir",
    "test:desktop": "node scripts/check-desktop.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@huggingface/transformers": "4.3.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "docx": "^9.5.1",
    "lucide-react": "^0.468.0",
    "pdfmake": "0.2.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "description": "VoxTexto para Windows: grabación y transcripción local.",
  "author": "VoxTexto",
  "build": {
    "appId": "dev.voxtexto.desktop",
    "nsis": {
      "artifactName": "VoxTexto-Setup-${version}.exe",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "productName": "VoxTexto",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icon-512.png",
      "signExecutable": false
    }
  }
}
